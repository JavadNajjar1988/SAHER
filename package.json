{
  "name": "saher-workspace",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/dev_runner.mjs dev",
    "dev:api": "node scripts/dev_runner.mjs api",
    "dev:worker": "node scripts/dev_runner.mjs worker",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "node scripts/dev_runner.mjs build",
    "lint": "node scripts/dev_runner.mjs build",
    "start": "node scripts/dev_runner.mjs dev",
    "test:api": "node scripts/dev_runner.mjs pytest",
    "test:web": "npx --yes tsx --test apps/web/src/services/apiClient.test.ts",
    "preview": "npm run preview --workspace=apps/web"
  },
  "dependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "typescript": "5.7.3",
    "vite": "6.1.0"
  }
}
